# The smallest possible image: the binary and nothing else. No CA certificates, no time zones, no users: fine for this
# API, wrong for one that calls HTTPS services.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod *.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/go-api .

FROM scratch
COPY --from=build /out/go-api /go-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/go-api"]
